[Unit]
Description=ThickEarth · Connect6 (Node HTTP server)
Documentation=https://github.com/fillgona62-a11y/ThickEarth-Connect6
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thickearth
Group=thickearth
WorkingDirectory=/opt/thickearth

# Web mode: registration + login, Origin checks on state-changing requests.
# Bind to loopback only — nginx is what faces the internet.
Environment=APP_MODE=web
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=DATA_DIR=/var/lib/thickearth
# Must match the public URL exactly, including the scheme.
Environment=PUBLIC_ORIGIN=https://thickearth.example.com
# Only set this once HTTPS is in place, otherwise the login cookie is rejected.
Environment=COOKIE_SECURE=1
EnvironmentFile=-/etc/thickearth/shared-llm.env

ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/index.js

Restart=on-failure
RestartSec=2

# The app only needs to write its database directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/thickearth

[Install]
WantedBy=multi-user.target
