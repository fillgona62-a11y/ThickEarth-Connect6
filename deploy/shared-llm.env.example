# Configure the provider once in the chosen administrator account's website Settings.
# Copy this file to /etc/thickearth/shared-llm.env and restart thickearth.
# No API key belongs in this file: it stays encrypted in that account's database row.
AI_SHARED_LLM=1
AI_SHARED_USER_EMAIL=owner@example.com
# Alternatively use the account ID; if both are set, ID takes priority:
# AI_SHARED_USER_ID=user_REPLACE_WITH_YOUR_ACCOUNT_ID

# Grants the site-administration role on startup. The flag is stored in the
# users table; registration cannot grant it. Admins get a shared-LLM switch
# in Settings → Site administration, persisted across restarts.
# ADMIN_USER_EMAIL=owner@example.com
# ADMIN_USER_ID=user_REPLACE_WITH_YOUR_ACCOUNT_ID

# Borrowed calls count toward the owner's per-game/monthly limits AND this
# per-borrower monthly allowance. Personal configurations always take priority.
AI_SHARED_MAX_CALLS_PER_USER=100
AI_MAX_CONCURRENT=4
AI_MAX_CONCURRENT_PER_USER=2
